# KOSIS 공유서비스에서 발급받은 키를 .env 파일에만 입력하세요.
# .env는 Git에서 제외됩니다.
KOSIS_API_KEY=

# 공공데이터포털 처리시설·나라장터 활용신청 후 발급받은 서비스키 (KOSIS와 별도)
DATA_GO_KR_SERVICE_KEY=

# 나라장터 전용 키가 별도로 있을 때 사용 (계약 수집은 JODAL 우선)
JODAL=

# 법제처 국가법령정보 Open API: OC는 사용자가 선택한 인증값입니다.
# 신청 시 등록한 서비스 도메인과 호출 서버의 공인 IP를 맞춰야 할 수 있습니다.
LAW_OC=
LAW_API_DOMAIN=
